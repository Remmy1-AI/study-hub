# Copy to `.env` for real Supabase phone OTP + live catalogue.
# Leave unset (or keep placeholders) to run mock auth: any phone + code 123456.
# If unset, app.config.js falls back to YEBOAH_SUPABASE_URL / YEBOAH_SUPABASE_ANON_KEY.
# Anon key only — never the service role key, access token, DB password or BulkClix key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
