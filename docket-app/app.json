{
  "expo": {
    "name": "Docket",
    "slug": "docket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "docket",
    "userInterfaceStyle": "light",
    "primaryColor": "#7A1F1F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "study.mryeboah.docket"
    },
    "android": {
      "package": "study.mryeboah.docket",
      "adaptiveIcon": {
        "backgroundColor": "#F3F0E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F0E6"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "remmy.s",
    "extra": {
      "eas": {
        "projectId": "199b96da-9d74-4993-9312-2c1802da8fe8"
      }
    }
  }
}
